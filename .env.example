# Copy to .env (install.sh does this for you). Compose reads .env next to compose.yaml.

# Page to show. https://..., http://..., or file:///pages/index.html for a file in PAGES_DIR.
URL='https://example.com'

# Display card. install.sh and the container refuse cards driven by the NVIDIA driver.
# cardN numbers follow driver probe order and can change at reboot. Prefer the stable
# by-path name, which install.sh prints for the card you chose:
#DRM_DEVICE='/dev/dri/by-path/pci-0000:03:00.0-card'
DRM_DEVICE='/dev/dri/card0'

# Virtual terminal to draw on. Pick one with no login prompt (7 is unused on most systems).
VT='7'

# Optional.
#PAGES_DIR='/opt/url-to-framebuffer/pages'
#CPUS='2'
#MEMORY_LIMIT='1g'
#PIDS_LIMIT='1024'
#TMP_SIZE='256m'
# Extra Chromium flags, space-separated.
#CHROMIUM_EXTRA_ARGS=''
